# ============================================================
# Freebuff Nova 环境变量示例（复制为 .env 后按需填写）
# 数据库自动选型逻辑见 ARCHITECTURE.md 4.4 节
# ============================================================

# 管理密码哈希（PBKDF2）。留空时：首次启动会在密码设置页自动生成并写入
# app_settings 的 settings:auth:password_hash；生产环境建议设置此变量覆盖。
AUTH_PASSWORD_HASH=

# 敏感字段信封加密主密钥（必填，Cloudflare 用 Secret / Vercel 用环境变量）。
# 未设置且非生产环境时，开发服务器会生成临时密钥（重启后失效）。
ENCRYPTION_KEY=

# 显式指定数据库驱动：sqlite | d1 | turso（不设置则按平台自动选型）
DB_DRIVER=

# SQLite（本地开发 / Docker 显式切换）
DB_PATH=./data/dev.sqlite

# Turso（Vercel / Deno / Docker 默认数据库）
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cloudflare D1 绑定名（wrangler 中声明的 binding 名，默认 DB）
D1_BINDING=DB